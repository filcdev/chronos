{
  "name": "@filcdev/filc",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "bunx biome check --write"
  },
  "packageManager": "bun@1.4.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "lint": "biome check --write .",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "prepare": "bun run .husky/install.ts || true"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@types/bun": "^1.4.0",
      "typescript": "^7.0.2",
      "hono": "^4.13.5",
      "better-auth": "^1.7.1",
      "zod": "^4.4.3"
    }
  }
}
